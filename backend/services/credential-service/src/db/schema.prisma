generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Credential {
  id               String   @id @default(uuid())
  uploaderClerkId  String
  title            String
  filename         String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
