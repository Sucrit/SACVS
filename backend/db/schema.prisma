generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}





// Enums 

enum Role {
  STUDENT
  ADMIN
  EMPLOYER
  INSTITUTION 
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CredentialStatus {
  PENDING
  VERIFIED
  AI_REVIEW
  ISSUED
  REVOKED
  EXPIRED
}

enum CredentialRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum CredentialType {
  TRANSCRIPT
  DIPLOMA
  CERTIFICATE
  DEGREE
  LICENSE
}

enum RequesterType {
  STUDENT
  EMPLOYER
  INSTITUTION
}

enum DeliveryMethod {
  DIGITAL
  PHYSICAL
  BOTH
}

enum AuditAction {

  // User actions
  USER_CREATED
  USER_APPROVED
  USER_REJECTED
  USER_SUSPENDED
  USER_DELETED
  
  // Credential actions
  CREDENTIAL_CREATED
  CREDENTIAL_ISSUED
  CREDENTIAL_VERIFIED
  CREDENTIAL_REVOKED
  CREDENTIAL_REQUESTED
  CREDENTIAL_REQUEST_APPROVED
  CREDENTIAL_REQUEST_REJECTED
  CREDENTIAL_REQUEST_PENDING 
  CREDENTIAL_REQUEST_COMPLETED 
  
  // AI and Blockchain Validation Actions
  AI_VALIDATION_RUN
  AI_VALIDATION_FAILED  
  BLOCKCHAIN_ANCHORED
  BLOCKCHAIN_ANCHORING_FAILED  

  // Role and permissions management
  ROLE_CHANGED
  ROLE_ASSIGNED  
  ROLE_REMOVED   
  USER_PERMISSIONS_UPDATED
  
  // Credential verification
  CREDENTIAL_REQUEST_VERIFIED 
  CREDENTIAL_VERIFIED_BY_AI 
  CREDENTIAL_VERIFIED_BY_BLOCKCHAIN

  // Security events
  ACCESS_GRANTED 
  ACCESS_DENIED  
  SUSPICIOUS_ACTIVITY_DETECTED  
  SECURITY_INCIDENT  
  
  // System and configuration changes
  SETTINGS_CHANGED
  SECURITY_ALERT
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  CREDENTIAL_ISSUED
  CREDENTIAL_VERIFIED
  CREDENTIAL_REVOKED
  CREDENTIAL_REQUEST_UPDATE
  SECURITY_ALERT
  SYSTEM_ANNOUNCEMENT
}







// User & Profile 

model User {
  id           String    @id @default(uuid())
  firstName    String
  middleName   String?
  lastName     String
  email        String    @unique
  role         Role      @default(STUDENT)
  status       Status    @default(PENDING)
  employerId   String?
  institutionId String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile            StudentProfile?
  studentCredentials Credential[]        @relation("StudentCredentials")
  issuedCredentials  Credential[]        @relation("IssuedCredentials")
  credentialRequests CredentialRequest[] @relation("StudentRequests")
  requestedRequests  CredentialRequest[] @relation("RequesterRequests")
  processedRequests  CredentialRequest[] @relation("ProcessedByInstitution")
  employer           Employer?           @relation("EmployerUsers", fields: [employerId], references: [id])
  institution        Institution?        @relation("InstitutionUsers", fields: [institutionId], references: [id])
  auditLogs          AuditLog[] 
  notifications      Notification[]

  @@index([role])
  @@index([status])
  @@index([employerId])
  @@index([institutionId])
}


// Student Profile 

model StudentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNumber String   @unique
  street        String
  barangay      String
  city          String
  province      String
  zipCode       Int
  phone         String
  courseOfStudy String
  yearLevel     String
  department    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentNumber])
}







// Credentials 

model Credential {
  id          String           @id @default(uuid())
  title       String
  type        CredentialType   @default(CERTIFICATE)
  status      CredentialStatus @default(PENDING)
  description String?

  studentId  String
  issuedById String
  student    User   @relation("StudentCredentials", fields: [studentId], references: [id])
  issuedBy   User   @relation("IssuedCredentials", fields: [issuedById], references: [id])

  filename   String?
  mimeType   String?
  storageKey String?
  fileHash   String?
  metadata   Json?

  aiStatus      String?
  aiScore       Float?
  aiReport      Json?
  aiValidatedAt DateTime?

  chain       String?
  txHash      String?
  blockNumber Int?
  anchoredAt  DateTime?

  issuedDate DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests CredentialRequest[]

  @@index([studentId])
  @@index([issuedById])
  @@index([status])
  @@index([type])
}







// Credential Requests 

model CredentialRequest {
  id               String      @id @default(uuid())
  studentId        String
  student          User        @relation("StudentRequests", fields: [studentId], references: [id])
  credentialId     String?
  credential       Credential? @relation(fields: [credentialId], references: [id])

  type             CredentialType
  title            String
  description      String?
  purpose          String?
  deliveryMethod   DeliveryMethod @default(DIGITAL)

  status           CredentialRequestStatus @default(PENDING)
  processedById    String?
  processedBy      User?                   @relation("ProcessedByInstitution", fields: [processedById], references: [id])
  processedAt      DateTime?
  rejectionReason  String?

  requesterType    RequesterType @default(STUDENT)
  requesterId      String
  requester        User         @relation("RequesterRequests", fields: [requesterId], references: [id])

  employerId       String?      // Employer initiating the request
  institutionId    String?      // Institution processing the request
  employer         Employer?    @relation("EmployerCredentialRequests", fields: [employerId], references: [id])
  institution      Institution? @relation("InstitutionCredentialRequests", fields: [institutionId], references: [id])

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([processedById])
  @@index([employerId])       
  @@index([institutionId])     
}








// Audit Logging 

model AuditLog {
  id          String        @id @default(uuid())
  action      AuditAction
  severity    AuditSeverity @default(INFO)
  actorId     String?
  actor       User?         @relation(fields: [actorId], references: [id])
  actorEmail  String?
  actorRole   Role?
  targetType  String?
  targetId    String?
  description String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@index([severity])
}









// Notifications 

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}










// Employer

model Employer {
  id          String   @id @default(uuid())
  companyName String
  registrationNumber String
  taxId       String
  email       String   @unique
  phoneNumber String
  status      Status   @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]              @relation("EmployerUsers")
  credentialRequests CredentialRequest[] @relation("EmployerCredentialRequests")

  @@index([email])
}









// Institution
model Institution {
  id          String   @id @default(uuid())
  name        String
  accreditationNumber String
  registrationNumber String
  email       String   @unique
  phoneNumber String
  status      Status   @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]              @relation("InstitutionUsers")
  credentialRequests CredentialRequest[] @relation("InstitutionCredentialRequests")

  @@index([email])
}
