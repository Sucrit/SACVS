generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}





// Enums 

enum Role {
  STUDENT
  ADMIN
  INSTITUTION
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CredentialStatus {
  PENDING
  ISSUED
  REVOKED
  EXPIRED
}

enum CredentialRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum CredentialType {
  TRANSCRIPT
  DIPLOMA
  CERTIFICATE
  DEGREE
  LICENSE
}

enum RequesterType {
  STUDENT
  INSTITUTION
}

enum DeliveryMethod {
  DIGITAL
  PHYSICAL
  BOTH
}

enum Sex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AuditAction {

  // User actions
  USER_CREATED
  USER_APPROVED
  USER_REJECTED
  USER_SUSPENDED
  USER_DELETED

  // Credential actions
  CREDENTIAL_CREATED
  CREDENTIAL_ISSUED
  CREDENTIAL_VERIFIED
  CREDENTIAL_REVOKED
  CREDENTIAL_REQUESTED
  CREDENTIAL_REQUEST_APPROVED
  CREDENTIAL_REQUEST_REJECTED
  CREDENTIAL_REQUEST_PENDING
  CREDENTIAL_REQUEST_COMPLETED

  // Blockchain Validation Actions
  BLOCKCHAIN_ANCHORED
  BLOCKCHAIN_ANCHORING_FAILED

  // Role and permissions management
  ROLE_CHANGED
  ROLE_ASSIGNED
  ROLE_REMOVED
  USER_PERMISSIONS_UPDATED

  // Credential verification
  CREDENTIAL_REQUEST_VERIFIED
  CREDENTIAL_VERIFIED_BY_BLOCKCHAIN

  // Security events
  ACCESS_GRANTED
  ACCESS_DENIED
  SUSPICIOUS_ACTIVITY_DETECTED
  SECURITY_INCIDENT

  // System and configuration changes
  SETTINGS_CHANGED
  SECURITY_ALERT
  QR_TOKEN_GENERATED
  QR_TOKEN_CONSUMED
  QR_TOKEN_INVALID
  QR_TOKEN_EXPIRED
  REQUEST_RECEIPT_GENERATED
  REQUEST_RECEIPT_VERIFIED
  REQUEST_RECEIPT_INVALID
  REQUEST_RECEIPT_EXPIRED
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum StepUpAction {
  ROLE_CHANGE
  STATUS_CHANGE
  CREDENTIAL_ISSUE
  BULK_STUDENT_CREATE
  QR_DOWNLOAD_ENABLE
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskReviewStatus {
  PENDING_REVIEW
  CONFIRMED_ABUSE
  BENIGN
  UNCERTAIN
}

enum AdminReadableReportStatus {
  PENDING
  READY
  FAILED
}

enum RiskReviewReasonCode {
  OTP_BRUTE_FORCE
  TOKEN_ABUSE
  RATE_LIMIT_ABUSE
  CROSS_SCOPE_ACCESS
  PRIVILEGE_MISUSE
  AUTOMATED_PROBING
  SUSPICIOUS_BULK_ACTIVITY
  OTHER_ABUSE
  USER_MISTAKE
  TEST_ACTIVITY
  EXPECTED_ADMIN_ACTION
  EXPECTED_INSTITUTION_FLOW
  FALSE_POSITIVE_PATTERN
  OTHER_BENIGN
  NEEDS_MORE_CONTEXT
  INSUFFICIENT_EVIDENCE
  MIXED_SIGNALS
}

enum RiskModelType {
  SUPERVISED
  ANOMALY
  ENSEMBLE
}

enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  CREDENTIAL_ISSUED
  CREDENTIAL_VERIFIED
  CREDENTIAL_REVOKED
  CREDENTIAL_REQUEST_UPDATE
  SECURITY_ALERT
  SYSTEM_ANNOUNCEMENT
}







// User

model User {
  id            String    @id @default(uuid())
  firstName     String
  middleName    String?
  lastName      String
  email         String    @unique
  role          Role      @default(STUDENT)
  status        Status    @default(PENDING)
  institutionId String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile            StudentProfile?
  studentCredentials Credential[]        @relation("StudentCredentials")
  issuedCredentials  Credential[]        @relation("IssuedCredentials")
  credentialRequests CredentialRequest[] @relation("StudentRequests")
  requestedRequests  CredentialRequest[] @relation("RequesterRequests")
  processedRequests  CredentialRequest[] @relation("ProcessedByInstitution")
  institution        Institution?        @relation("InstitutionUsers", fields: [institutionId], references: [id])
  auditLogs          AuditLog[]
  notifications      Notification[]
  createdNotificationBroadcasts NotificationBroadcast[] @relation("CreatedNotificationBroadcasts")
  qrTokens           CredentialQrToken[]
  stepUpChallenges   StepUpChallenge[]
  stepUpSessions     StepUpSession[]
  requestApprovalReceipts CredentialRequestApprovalReceipt[] @relation("ReceiptStudent")

  @@index([role])
  @@index([status])
  @@index([institutionId])
}







// Student Profile 

model StudentProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNumber        String   @unique
  street               String
  barangay             String
  city                 String
  province             String
  zipCode              Int
  phone                String?
  courseOfStudy        String
  yearLevel            String
  department           String
  birthday             DateTime?
  sex                  Sex?
  guardianFullName     String?
  guardianRelationship String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([studentNumber])
}







// Credentials 

model Credential {
  id          String           @id @default(uuid())
  title       String
  type        CredentialType   @default(CERTIFICATE)
  status      CredentialStatus @default(PENDING)
  description String?

  studentId  String
  issuedById String
  student    User   @relation("StudentCredentials", fields: [studentId], references: [id])
  issuedBy   User   @relation("IssuedCredentials", fields: [issuedById], references: [id])

  filename   String?
  mimeType   String?
  storageKey String?
  fileHash   String?
  metadata   Json?

  chain       String?
  txHash      String?
  blockNumber Int?
  anchoredAt  DateTime?

  issuedDate DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests CredentialRequest[]
  qrTokens          CredentialQrToken[]
  qrDocumentTokens  CredentialQrDocumentToken[]

  @@index([studentId])
  @@index([issuedById])
  @@index([status])
  @@index([type])
}






// Credential Qr token

model CredentialQrToken {
  id            String   @id @default(uuid())
  credentialId  String
  studentId     String
  tokenHash     String   @unique
  allowDocumentPreview Boolean @default(false)
  allowDocumentDownload Boolean @default(false)
  expiresAt     DateTime
  usedAt        DateTime?
  usedByType    String?
  usedById      String?
  usedByIp      String?
  invalidatedAt DateTime?
  createdAt     DateTime @default(now())

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentToken CredentialQrDocumentToken?

  @@index([credentialId, studentId, expiresAt])
  @@index([studentId, createdAt])
  @@index([usedAt])
  @@index([invalidatedAt])
}







// Credentiel document token

model CredentialQrDocumentToken {
  id           String   @id @default(uuid())
  qrTokenId    String   @unique
  credentialId String
  tokenHash    String   @unique
  expiresAt    DateTime
  usedAt       DateTime?
  usedByIp     String?
  createdAt    DateTime @default(now())

  qrToken    CredentialQrToken @relation(fields: [qrTokenId], references: [id], onDelete: Cascade)
  credential Credential        @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, expiresAt])
  @@index([usedAt])
}







// Step up challenge

model StepUpChallenge {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      StepUpAction
  targetId    String?
  payloadHash String?
  codeHash    String
  expiresAt   DateTime
  attempts    Int          @default(0)
  maxAttempts Int          @default(5)
  lockedAt    DateTime?
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())

  session StepUpSession?

  @@index([userId, createdAt])
  @@index([action, expiresAt])
  @@index([expiresAt])
}







// Step up session

model StepUpSession {
  id          String          @id @default(uuid())
  challengeId String          @unique
  challenge   StepUpChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      StepUpAction
  targetId    String?
  payloadHash String?
  tokenHash   String          @unique
  expiresAt   DateTime
  usedAt      DateTime?
  reusable    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([userId, action, expiresAt])
  @@index([expiresAt])
  @@index([usedAt])
}







// Credential Requests 

model CredentialRequest {
  id           String      @id @default(uuid())
  studentId    String
  student      User        @relation("StudentRequests", fields: [studentId], references: [id])
  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id])

  type           CredentialType
  title          String
  description    String?
  purpose        String?
  deliveryMethod DeliveryMethod @default(DIGITAL)

  status          CredentialRequestStatus @default(PENDING)
  processedById   String?
  processedBy     User?                   @relation("ProcessedByInstitution", fields: [processedById], references: [id])
  processedAt     DateTime?
  rejectionReason String?

  requesterType RequesterType @default(STUDENT)
  requesterId   String
  requester     User          @relation("RequesterRequests", fields: [requesterId], references: [id])

  institutionId String? // Institution processing the request
  institution   Institution? @relation("InstitutionCredentialRequests", fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approvalReceipts CredentialRequestApprovalReceipt[]

  @@index([studentId])
  @@index([status])
  @@index([processedById])
  @@index([institutionId])
}







// Approved request receipt

model CredentialRequestApprovalReceipt {
  id            String   @id @default(uuid())
  requestId      String
  studentId      String
  institutionId  String
  receiptCode    String   @unique
  tokenHash      String   @unique
  expiresAt      DateTime
  usedAt         DateTime?
  invalidatedAt  DateTime?
  createdAt      DateTime @default(now())

  request      CredentialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  student      User              @relation("ReceiptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  institution  Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([requestId, studentId, expiresAt])
  @@index([studentId, createdAt])
  @@index([usedAt])
  @@index([invalidatedAt])
}










model RiskModelVersion {
  id            String        @id @default(uuid())
  modelVersion  String        @unique
  modelType     RiskModelType
  description   String?
  featureSchema Json?
  metrics       Json?
  artifactPath  String?
  isActive      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  riskEvents RiskEventRecord[]

  @@index([modelType, createdAt])
  @@index([isActive])
}










model RiskFeatureSnapshot {
  id                 String     @id @default(uuid())
  eventId            String?
  correlationId      String?
  actorId            String?
  actorRole          Role?
  institutionId      String?
  action             String
  targetType         String?
  targetId           String?
  ipHash             String?
  userAgentHash      String?
  features           Json
  featuresWindowStart DateTime?
  featuresWindowEnd   DateTime?
  observedAt         DateTime
  createdAt          DateTime   @default(now())

  riskEvents RiskEventRecord[]

  @@index([eventId])
  @@index([correlationId, observedAt])
  @@index([actorId, observedAt])
  @@index([action, observedAt])
  @@index([createdAt])
}









model RiskEventRecord {
  id                  String           @id @default(uuid())
  eventId             String?
  correlationId       String?
  actorId             String?
  action              String
  featuresSnapshotRef String
  featuresSnapshot    RiskFeatureSnapshot @relation(fields: [featuresSnapshotRef], references: [id], onDelete: Cascade)
  riskScore           Float
  riskBand            RiskBand
  topSignals          Json?
  modelVersionId      String?
  modelVersionRef     RiskModelVersion?  @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)
  modelVersion        String
  inferenceTs         DateTime
  reviewStatus        RiskReviewStatus @default(PENDING_REVIEW)
  reviewedById        String?
  reviewedAt          DateTime?
  reviewReasonCode    RiskReviewReasonCode?
  reviewReasonDetail  String?
  reviewNotes         String?
  adminReadableReport Json?
  adminReadableReportStatus AdminReadableReportStatus @default(PENDING)
  adminReadableReportGeneratedAt DateTime?
  adminReadableReportModel String?
  adminReadableReportError String?
  createdAt           DateTime         @default(now())

  @@index([eventId])
  @@index([correlationId, inferenceTs])
  @@index([actorId, inferenceTs])
  @@index([riskBand, inferenceTs])
  @@index([reviewStatus, inferenceTs])
  @@index([reviewReasonCode, inferenceTs])
  @@index([createdAt])
}

model GatewayRequestTelemetry {
  id                 String    @id @default(uuid())
  eventId            String    @unique
  correlationId      String?
  requestTs          DateTime
  routeKey           String
  routeClass         String
  method             String
  statusCode         Int
  durationMs         Int
  rateLimitOutcome   String
  actorId            String?
  actorRole          Role?
  actorIdentityHash  String?
  ipHash             String?
  userAgentHash      String?
  is401              Boolean   @default(false)
  is403              Boolean   @default(false)
  is429              Boolean   @default(false)
  is5xx              Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([requestTs])
  @@index([correlationId, requestTs])
  @@index([actorId, requestTs])
  @@index([routeClass, requestTs])
  @@index([routeKey, requestTs])
  @@index([statusCode, requestTs])
  @@index([rateLimitOutcome, requestTs])
  @@index([createdAt])
}








// Audit Logging 

model AuditLog {
  id          String        @id @default(uuid())
  action      AuditAction
  severity    AuditSeverity @default(INFO)
  actorId     String?
  actor       User?         @relation(fields: [actorId], references: [id])
  actorEmail  String?
  actorRole   Role?
  targetType  String?
  targetId    String?
  description String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@index([severity])
}









// Notifications 

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model NotificationBroadcast {
  id             String   @id @default(uuid())
  institutionId  String
  createdById    String
  targetScope    String
  title          String
  message        String
  recipientCount Int
  createdAt      DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("CreatedNotificationBroadcasts", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([institutionId, createdAt])
  @@index([createdById, createdAt])
}









// Institution

model Institution {
  id                  String   @id @default(uuid())
  institutionName                String
  accreditationNumber String
  registrationNumber  String
  email               String   @unique
  phoneNumber         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users              User[]              @relation("InstitutionUsers")
  credentialRequests CredentialRequest[] @relation("InstitutionCredentialRequests")
  requestApprovalReceipts CredentialRequestApprovalReceipt[]
  notificationBroadcasts NotificationBroadcast[]

  @@index([email])
}

