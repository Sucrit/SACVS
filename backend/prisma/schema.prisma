generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  REGISTRAR
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id           String   @id @default(uuid())
  clerkId      String   @unique
  role         Role     @default(STUDENT)
  status       Status   @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentCredentials Credential[] @relation("StudentCredentials")
  issuedCredentials  Credential[] @relation("IssuedCredentials")
}

enum CredentialStatus {
  PENDING
  ISSUED
  VERIFIED
  REVOKED
  EXPIRED
}

model Credential {
  id          String           @id @default(uuid())
  title       String
  status      CredentialStatus @default(PENDING)

  studentId   String
  issuedById  String
  student     User   @relation("StudentCredentials", fields: [studentId], references: [id])
  issuedBy    User   @relation("IssuedCredentials", fields: [issuedById], references: [id])

  filename    String?
  mimeType    String?
  storageKey  String?
  fileHash    String?
  metadata    Json?

  aiStatus    String?
  aiScore     Float?
  aiReport    Json?

  chain       String?
  txHash      String?
  anchoredAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([issuedById])
}
